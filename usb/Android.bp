cc_binary {
    name: "usb_data_sync",
    vendor: true,

    srcs: ["usb_data_sync.cpp"],

    shared_libs: [
        "libbase",
        "liblog",
        "libbinder_ndk",
        "android.hardware.usb-V4-ndk",
    ],

    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}

prebuilt_etc {
    name: "init.gs101.usb_data_sync.rc",
    src: "init.gs101.usb_data_sync.rc",
    sub_dir: "init/hw",
    vendor: true,
}

